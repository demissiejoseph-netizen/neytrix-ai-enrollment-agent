<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Orchestration tests construct DefaultHttpContext/HttpContextAccessor and use
       NullLogger from the shared framework, so the test host needs the ASP.NET
       Core framework reference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Tenant-isolation integration test: spins a real Postgres in Docker and
         self-skips (SkippableFact) when Docker is unavailable. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NeytrixAI.Domain\NeytrixAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\NeytrixAI.Infrastructure\NeytrixAI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NeytrixAI.Api\NeytrixAI.Api.csproj" />
  </ItemGroup>

</Project>
