# =============================================================================
# Neytrix AI Enrollment Agent — environment reference
#
# Copy to .env for local development ONLY. .env is gitignored and dockerignored.
# In production nothing here is a literal: values marked [SECRET] live in Google
# Secret Manager and are mounted with `gcloud run deploy --set-secrets`, while
# values marked [ENV] are passed with `--set-env-vars`.
#
# ASP.NET Core maps a double underscore to config-section nesting, so
# Stripe__SecretKey binds to Configuration["Stripe:SecretKey"].
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime — [ENV], except PORT
# -----------------------------------------------------------------------------
# PORT is injected by Cloud Run. Do NOT set it in --set-env-vars; the deploy
# will be rejected because PORT is a reserved variable.
PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# The Dockerfile entrypoint derives --urls from $PORT. Only set this locally.
ASPNETCORE_URLS=http://0.0.0.0:8080

# -----------------------------------------------------------------------------
# Database — [SECRET] neytrix-db-connection
# -----------------------------------------------------------------------------
# Supabase/Postgres. Connect as the neytrix_app role so RLS tenant policies
# apply — never as a superuser or the postgres role, which bypasses RLS.
# Include Pooling and a modest MaxPoolSize: Cloud Run scales horizontally and
# each instance holds its own pool.
ConnectionStrings__DefaultConnection=Host=aws-0-us-west-1.pooler.supabase.com;Port=6543;Database=postgres;Username=neytrix_app.PROJECT_REF;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;MinPoolSize=0;MaxPoolSize=10

# -----------------------------------------------------------------------------
# Vertex AI — [ENV]
# -----------------------------------------------------------------------------
# Requires aiplatform.googleapis.com enabled and roles/aiplatform.user on the
# Cloud Run runtime service account. If ProjectId is empty the app boots with a
# null model client that returns a canned escalation reply — useful for smoke
# tests, useless in production.
VertexAI__ProjectId=neytrix-prod
VertexAI__Location=us-west1
VertexAI__Model=gemini-1.5-pro

# GOOGLE_APPLICATION_CREDENTIALS is NOT set on Cloud Run. The runtime service
# account supplies Application Default Credentials automatically. Only set this
# locally, pointing at a downloaded key you keep out of git.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-dev-key.json

# -----------------------------------------------------------------------------
# Stripe — SecretKey and WebhookSecret are [SECRET]
# -----------------------------------------------------------------------------
# neytrix-stripe-secret-key
Stripe__SecretKey=sk_test_REPLACE_ME
# neytrix-stripe-webhook-secret. Rotate independently of deploys; the value must
# match the endpoint you registered for POST /api/v1/chat/webhooks/stripe.
Stripe__WebhookSecret=whsec_REPLACE_ME
# [ENV] Where guardians land after checkout. {registrationId} is substituted.
Stripe__SuccessUrlTemplate=https://REPLACE_WITH_WIDGET_HOST/enrollment/{registrationId}/complete
Stripe__CancelUrlTemplate=https://REPLACE_WITH_WIDGET_HOST/enrollment/{registrationId}/cancelled
# [ENV] Base URL for the hosted waiver form.
Stripe__WaiverBaseUrl=https://REPLACE_WITH_WIDGET_HOST

# -----------------------------------------------------------------------------
# Google Calendar — ClientId and ClientSecret are [SECRET]
# -----------------------------------------------------------------------------
# neytrix-gcal-client-id
GoogleCalendar__ClientId=REPLACE_ME.apps.googleusercontent.com
# neytrix-gcal-client-secret
GoogleCalendar__ClientSecret=REPLACE_ME
# [ENV] Chicken-and-egg: Cloud Run assigns the *.run.app host on first deploy.
# Deploy once, read the URL, set this to the real value, then redeploy.
GoogleCalendar__RedirectUri=https://REPLACE_WITH_SERVICE_URL/oauth/callback

# -----------------------------------------------------------------------------
# Platform — [ENV]
# -----------------------------------------------------------------------------
# Comma-separated widget origins. A wildcard here defeats the tenant scoping
# enforced in TenantMiddleware — list explicit hosts.
ALLOWED_ORIGINS=https://app.neytrix.com,https://widget.neytrix.com,http://localhost:3000
# Pilot convenience only. Remove before onboarding a second tenant, otherwise a
# missing X-Tenant-Slug header silently resolves to this org.
DEFAULT_TENANT_SLUG=

# [SECRET] neytrix-clerk-secret-key — only if the admin console is served behind
# the same Cloud Run service. Leave unset for the API-only deployment.
# CLERK_SECRET_KEY=sk_test_REPLACE_ME
