# Neytrix AI Enrollment Agent — environment template.
#
# Copy to `.env` (git-ignored) for local runs, or map each key into your
# secrets manager / container environment for deployment. ASP.NET Core reads
# these via the standard "__" section separator, e.g.
#   ConnectionStrings__DefaultConnection overrides ConnectionStrings:DefaultConnection.
#
# LEAVE PLACEHOLDER VALUES EMPTY — do NOT commit real secrets. Every value below
# is either a non-secret default or a placeholder you must fill in.

# ── Database ────────────────────────────────────────────────────────────────
# The application MUST connect as a NON-superuser, NON-BYPASSRLS role (see
# db/migrations/002_rls_hardening.sql), otherwise tenant Row-Level Security is
# silently bypassed. Do not point this at the table owner / postgres superuser.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=neytrix_enrollment;Username=neytrix_app;Password=

# ── Stripe (payment links + webhook) ────────────────────────────────────────
# Create these in the Stripe Dashboard. Secret key starts with sk_...; the
# webhook secret (whsec_...) is shown when you register the webhook endpoint.
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__WaiverBaseUrl=https://app.neytrix.ai
Stripe__SuccessUrlTemplate=https://app.neytrix.ai/enrol/success?registration={registrationId}
Stripe__CancelUrlTemplate=https://app.neytrix.ai/enrol/cancel?registration={registrationId}

# ── Google Calendar (assessment scheduling) ─────────────────────────────────
# Paste the FULL service-account key JSON as a single-line string, or better,
# inject it from a secret store rather than a committed file.
GoogleCalendar__ServiceAccountKeyJson=
GoogleCalendar__DefaultLocation=
GoogleCalendar__DefaultAssessmentDurationMinutes=60

# ── ASP.NET Core runtime ────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
